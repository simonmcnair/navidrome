# ============================================================
# REQUIRED CHANGES
# ============================================================

# Existing Cloudflare API token previously used by SWAG for DNS-01.
CF_DNS_API_TOKEN=REPLACE_WITH_YOUR_CLOUDFLARE_API_TOKEN

# Email for Let's Encrypt ACME registration.
ACME_EMAIL=you@example.com

# Your existing DDNS hostname.
# No wildcard is used.
DOMAIN=35.example.com

# Absolute NAS path for Navidrome application/database data.
NAVIDROME_DATA=/CHANGE/ME/navidrome/data

# Absolute NAS path containing your music.
MUSIC_PATH=/CHANGE/ME/music

# User/group IDs Navidrome runs as (must own NAVIDROME_DATA and be able to
# read MUSIC_PATH). Find them with: id <your-nas-user>
PUID=1000
PGID=1000

# Docker network for Traefik and the apps behind it. Change only if this
# subnet clashes with your LAN or another Docker network.
PROXY_SUBNET=172.30.10.0/24
# Traefik's fixed address in PROXY_SUBNET. Navidrome trusts the SSO header
# from this address only.
TRAEFIK_PROXY_IP=172.30.10.2

# ============================================================
# AUTHENTIK
# ============================================================

# Use the exact version recommended by the current Authentik release
# documentation. Do not use :latest.
AUTHENTIK_TAG=2026.8.3

# Generate a long random value, e.g.:
# openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Generate a strong PostgreSQL password, e.g.:
# openssl rand -base64 36 | tr -d '\n'
PG_PASS=REPLACE_WITH_A_STRONG_POSTGRES_PASSWORD

# Password and email for the built-in akadmin account, created on first
# start. Generate e.g.: openssl rand -base64 24 | tr -d '\n'
AUTHENTIK_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD
AUTHENTIK_BOOTSTRAP_EMAIL=you@example.com

# Hostname for the Authentik UI (needs its own DNS record, e.g. a CNAME to DOMAIN).
AUTHENTIK_DOMAIN=auth.CHANGE-ME.example.com

# Bind Authentik admin port 9000 to the NAS LAN IP only.
# If left unset it is reachable from the NAS itself only (127.0.0.1).
AUTHENTIK_ADMIN_BIND=192.168.1.10
